{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "@portfolio/admin#build": {
      "dependsOn": ["@portfolio/shared#build"]
    },
    "@portfolio/user#build": {
      "dependsOn": ["@portfolio/shared#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
