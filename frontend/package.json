{
  "name": "portfolios-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:user": "pnpm --filter @portfolio/user dev",
    "dev:admin": "pnpm --filter @portfolio/admin dev",
    "build:user": "pnpm --filter @portfolio/user build",
    "build:admin": "pnpm --filter @portfolio/admin build",
    "build:shared": "pnpm --filter @portfolio/shared build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.13.1"
}
