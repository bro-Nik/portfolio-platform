# -------------------- Общие переменные --------------------
# Эти переменные должны быть определены в каждом сервисе:
# service := "auth"     # контейнер сервиса
# db := "auth-db"       # контейнер БД

compose := "-f compose.base.yml -f compose.dev.yml"
compose_test := "-f compose.test.yml"
backup_dir := "./db_backups"

set dotenv-load := true
set unstable

db_name := env_var_or_default("POSTGRES_DB", "postgres")
db_user := env_var_or_default("POSTGRES_USER", "postgres")
db_password := env_var_or_default("POSTGRES_PASSWORD", "postgres")

# -------------------- Основные команды --------------------
# Запустить сервис (пример: just up, just up -d, just up --build)
up *args:
	@docker compose {{compose}} up {{args}}

# Остановить сервис
down:
	@docker compose {{compose}} down

# Посмотреть логи
logs:
	@docker compose {{compose}} logs -f {{service}}

# Список контейнеров
ps:
	@docker compose {{compose}} ps

# -------------------- Разработка --------------------
# Войти в контейнер
shell:
	@just _ensure_app
	@docker compose {{compose}} exec {{service}} sh

# Запустить одну команду в контейнере (пример: just run "python -m app.migrate")
exec cmd:
	@just _ensure_app
	@docker compose {{compose}} exec {{service}} {{cmd}}

# Очистить все (контейнеры, volumes)
clean:
	@read -p "❗ Это удалит ВСЕ данные! Продолжить? (y/n) " confirm; \
	[ "$confirm" = "y" ] && docker compose {{compose}} down -v && echo "✅ Очищено" || echo "❌ Отменено"

# -------------------- Тесты --------------------
# Запустить тесты (пример: just tests, just tests --build)
tests *args:
	@[ "$(just _has_tests)" = "true" ] || { echo "❌ Нет тестов"; exit 0; }; \
	docker compose {{compose_test}} up --abort-on-container-exit --exit-code-from {{service}} {{args}}; status=$?; \
	docker compose {{compose_test}} down -v; \
	exit $status

# -------------------- Миграции --------------------
# Применить миграции
migrate:
	@started=$(just _ensure_db); \
	docker compose {{compose}} run --rm {{service}} alembic upgrade head; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# Создать новую миграцию
migrate-new msg:
	@docker compose {{compose}} run --rm {{service}} alembic revision --autogenerate -m "{{msg}}"

# Откатить последнюю миграцию
migrate-down:
	@started=$(just _ensure_db); \
	docker compose {{compose}} run --rm {{service}} alembic downgrade -1; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# Показать текущую миграцию
migrate-current:
	@started=$(just _ensure_db); \
	docker compose {{compose}} run --rm {{service}} alembic current; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# -------------------- Базы данных --------------------
# Создать бэкап
backup:
	@started=$(just _ensure_db); \
	just _create_db_backup; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# Восстановить из последнего бэкапа
restore-latest:
	@latest=$(ls -t {{backup_dir}}/*.sql 2>/dev/null | head -1); \
	started=$(just _ensure_db); \
	just _restore_db "$latest"; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# Восстановить из конкретного файла
restore-file file:
	@started=$(just _ensure_db); \
	just _restore_db "{{file}}"; status=$?; \
	[ "$started" = "true" ] && just _stop_db; \
	exit $status

# Список бэкапов
backup-list:
	@[ "$(just _has_backups)" = "true" ] || { echo "❌ Нет бэкапов"; exit 0; }; \
	echo "💾 Бэкапы {{db}}:"; \
	ls -1 {{backup_dir}}/*.sql | sed 's/^/  📄 /'; \
	total_size=$(du -sh {{backup_dir}} | cut -f1); \
	echo "  📊 Общий размер: $total_size"

# Удалить бэкапы
backup-del keep="5":
	@[ "$(just _has_backups)" = "true" ] || { echo "❌ Нет бэкапов"; exit 0; }; \
	echo "🧹 Очистка бэкапов..."; \
	total=$(ls -1 {{backup_dir}}/*.sql 2>/dev/null | wc -l); \
	if [ "{{keep}}" = "0" ]; then \
		rm -v {{backup_dir}}/*.sql 2>/dev/null | sed 's/^/  /'; \
		echo "  ✅ Все бэкапы удалены"; \
	elif [ $total -le {{keep}} ]; then \
		echo "  ✅ Всего $total бэкапов (<= {{keep}}), ничего не удалено"; \
	else \
		ls -t {{backup_dir}}/*.sql | tail -n $((total - {{keep}})) | xargs rm -v | sed 's/^/  /'; \
		echo "  ✅ Оставлено {{keep}} бэкапов"; \
	fi

# -------------------- Приватные рецепты --------------------
_has_tests:
	@[ -d "./tests" ] && [ -f "./compose.test.yml" ] && echo "true" || echo "false"

_has_backups:
	@[ -d "{{backup_dir}}" ] && ls {{backup_dir}}/*.sql 2>/dev/null | head -1 | grep -q . && echo "true" || echo "false"

_ensure_app:
	@if ! docker compose {{compose}} ps --status running | grep -q {{service}}; then \
		docker compose {{compose}} up -d {{service}} > /dev/null 2>&1; \
		sleep 3; echo "true"; \
	else \
		echo "false"; fi

_ensure_db:
	@if ! docker compose {{compose}} ps --status running | grep -q {{db}}; then \
		docker compose {{compose}} up -d {{db}} > /dev/null 2>&1; \
		sleep 3; echo "true"; \
	else \
		echo "false"; fi

_stop_db:
	@docker compose {{compose}} stop {{db}} > /dev/null 2>&1

_create_db_backup:
	@echo "💾 Создание бэкапа..."; \
	timestamp=$(date +%Y%m%d_%H%M%S); \
	filename="{{backup_dir}}/$timestamp.sql"; \
	mkdir -p {{backup_dir}}; \
	if docker compose {{compose}} exec -T {{db}} pg_dump -U {{db_user}} {{db_name}} > $filename; then \
		echo "  ✅ Сохранено: $filename"; \
	else \
		echo "  ❌ Ошибка создания бэкапа"; rm -f "$filename"; exit 1; fi

_restore_db file:
	@echo "💾 Восстановление бэкапа..."; \
	[ -f "{{file}}" ] || { echo "❌ Файл {{file}} не найден"; exit 1; }; \
	if cat "{{file}}" | docker compose {{compose}} exec -T {{db}} psql -U {{db_user}} -d {{db_name}}; then \
		echo "  ✅ Восстановлено из {{file}}"; \
	else \
		echo "  ❌ Ошибка восстановления"; exit 1; fi
