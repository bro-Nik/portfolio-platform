# Copy to .env.selfhost and set your own values, or run:
#   ./scripts/selfhost.sh init   # generates .env.selfhost with random secrets

# Host port exposed by nginx. Change if port 80 is already taken.
NGINX_PORT=80

# Connection budget per process (web + worker + scheduler). Sum across processes
# and keep it below the server's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# Worker concurrency must stay within DB_POOL_SIZE + DB_MAX_OVERFLOW, otherwise
# tasks queue on the pool and fail on timeout.
TASKIQ_WORKERS=1
TASKIQ_MAX_ASYNC_TASKS=4


# Signs auth tokens — keep it secret and random.
# ./scripts/selfhost.sh init generates one; the app refuses to start with a
# placeholder secret in production.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial admin user created by the init service on first start.
# ./scripts/selfhost.sh init generates a random password here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Rate limiting is forced on in production; this flag only affects development.
RATE_LIMIT_ENABLED=true
