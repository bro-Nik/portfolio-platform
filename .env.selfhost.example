# Copy to .env.selfhost and set your own values, or run:
#   ./scripts/selfhost.sh init   # generates .env.selfhost with random secrets

# Host port exposed by nginx. Change if port 80 is already taken.
NGINX_PORT=80


# Signs auth tokens — keep it secret and random.
JWT_SECRET=change-me-to-a-unique-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial admin user created by the init service on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

RATE_LIMIT_ENABLED=false
