ENV=production

DB_URL=postgresql+asyncpg://portfolios:your_db_password@db/portfolios

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-this-to-a-very-long-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-domain.com
FRONTEND_URL=https://your-domain.com
