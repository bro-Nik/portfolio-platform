ENV=development

POSTGRES_USER=postgres
POSTGRES_DB=postgres

DB_URL=postgresql+asyncpg://postgres@db/postgres
# Бюджет соединений на процесс: web + worker + scheduler. Суммируется и должно
# помещаться в max_connections PostgreSQL вместе с резервом.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_URL=redis://redis:6379/0

# Конкурентность воркера не должна превышать DB_POOL_SIZE + DB_MAX_OVERFLOW.
TASKIQ_WORKERS=1
TASKIQ_MAX_ASYNC_TASKS=4

JWT_SECRET=your-super-secret-jwt-token
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:8081

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@portfolios.app

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Development only. Production forces rate limiting on regardless of this value.
RATE_LIMIT_ENABLED=false
